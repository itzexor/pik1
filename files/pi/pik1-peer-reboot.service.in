[Unit]
Description=Propagate Pi reboot to PiK1 peer
DefaultDependencies=no
After=pik1.service
Before=reboot.target
# Skip when this shutdown was itself commanded by the peer -- relaying it
# back would reboot the initiator a second time.
ConditionPathExists=!/run/pik1/peer-initiated

[Service]
Type=oneshot
ExecStart=-@INSTALL_DIR@/pik1d --control reboot
TimeoutStartSec=5

[Install]
WantedBy=reboot.target
