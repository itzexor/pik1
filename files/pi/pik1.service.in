[Unit]
Description=PiK1 gadget setup and serialmux bridge
DefaultDependencies=no
After=sysinit.target local-fs.target systemd-udevd.service
Before=klipper.service shutdown.target reboot.target poweroff.target halt.target

[Service]
Type=simple

# Gadget setup must run as root (writes to /sys/kernel/config)
ExecStartPre=+@INSTALL_DIR@/setup_otg.sh

# Daemon runs as the klipper user so PTY devices are accessible to klipper
User=1000
Group=1000
RuntimeDirectory=pik1
# Keep /run/pik1 (and the peer-initiated marker) when the daemon exec's
# into systemctl for a peer-commanded reboot/poweroff -- the peer-* hook
# units evaluate their ConditionPathExists against it during shutdown.
RuntimeDirectoryPreserve=yes

ExecStart=@INSTALL_DIR@/pik1d --usb 1d6b:0104 \
    pty:0:/tmp/klipper_mcu \
    pty:1:/tmp/klipper_toolhead \
    @TCP_SPEC@

Restart=always
RestartKillSignal=SIGUSR1
RestartSec=2

StandardOutput=journal
StandardError=journal
SyslogIdentifier=pik1

[Install]
WantedBy=multi-user.target
