#!/bin/sh
# shutdown_command.sh — K1-initiated poweroff/reboot that propagates to the Pi.
#
# Intended to be called from the touchscreen UI. Sends the matching peer
# command to the Pi over the pik1 control channel, waits for the peer's
# acknowledgement, then performs the local action. If the peer cannot be
# reached the local action still proceeds — the operator asked for a
# poweroff, so do not strand the machine.
#
# Usage: shutdown_command.sh poweroff|reboot

PIK1D="@INSTALL_DIR@/pik1d"

if [ "$#" -ne 1 ] ||
   { [ "$1" != poweroff ] && [ "$1" != reboot ]; }; then
    echo "Usage: $0 poweroff|reboot" >&2
    exit 2
fi

if ! "$PIK1D" --control "$1"; then
    echo "warning: peer $1 failed, continuing with local $1" >&2
fi

exec "$1"
