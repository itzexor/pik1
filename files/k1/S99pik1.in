#!/bin/sh
# /etc/init.d/S99pik1 — pik1 K1 side: bridges K1C MCU UARTs to the Pi over USB CDC ACM.

INSTALL_DIR="@INSTALL_DIR@"
BINARY="$INSTALL_DIR/pik1d"
PIDFILE="/var/run/pik1.pid"
LOGFILE="/tmp/pik1.log"

# USB gadget VID:PID (set by setup_pik1.sh on the Pi)
USB_ID="1d6b:0104"

# main MCU
CH0_DEV="/dev/ttyS7"
CH0_BAUD="230400"

# toolhead MCU
CH1_DEV="/dev/ttyS1"
CH1_BAUD="230400"

# TCP tunnel — Moonraker port forwarded to the Pi.
# Keep this on 127.0.0.1 unless you intentionally want an unauthenticated
# Moonraker tunnel listener exposed on the K1 network interface.
TCP_ADDR="127.0.0.1"
TCP_PORT="7125"

DAEMON_ARGS="--usb $USB_ID \
    mcu:0:$CH0_DEV:$CH0_BAUD \
    mcu:1:$CH1_DEV:$CH1_BAUD \
    @TCP_SPEC@"

case "$1" in
    start)
        if [ ! -x "$BINARY" ]; then
            echo "Error: $BINARY not found or not executable" >&2
            exit 1
        fi
        echo "Starting pik1..."
        mkdir -p /run/pik1
        start-stop-daemon -S -b -m -p "$PIDFILE" \
            -x /bin/sh -- -c "exec $BINARY $DAEMON_ARGS >> $LOGFILE 2>&1"
        ;;
    stop)
        echo "Stopping pik1..."
        start-stop-daemon -K -p "$PIDFILE" 2>/dev/null
        killall -q tcpbridge 2>/dev/null || true
        rm -f "$PIDFILE"
        ;;
    restart|reload)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "pik1 is running (pid $(cat "$PIDFILE"))"
        else
            echo "pik1 is not running"
            exit 1
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|reload|status}" >&2
        exit 1
        ;;
esac
